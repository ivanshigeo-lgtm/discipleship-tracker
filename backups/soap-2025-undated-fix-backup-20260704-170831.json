          "date_precision": "year",
          "date_reviewed": true,
          "id": "bee6cbb4-e49d-4f49-b442-f1bf6d199a00",
          "import_batch_id": "b6b1042e-bed6-40e2-80f4-debdd9e59219",
          "import_seq": 2001,
          "journal_date": "2025-01-01",
          "ocr_text": "Application: I need to evaluate my life in light of eternity. What am I storing up? Am I living for temporal things or eternal things? I should be giving generously, not hoarding. I should be serving the Lord with my time, talents, \u0026 treasure. God has given me these things to steward. I will ask myself daily: \"Does this matter for eternity?\" Prayer: Lord, help me to see life from Your eternal perspective. Help me not to be consumed with temporal things. Give me wisdom to number my days. Help me to store up treasures in heaven. Help me to be a good steward of all You've entrusted to me. In Jesus' name, Amen.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783212266236.jpeg",
