        {
          "created_at": "2026-07-05T00:48:36.919386+00:00",
          "date_precision": "day",
          "id": "71cea3b1-df8a-46ad-81d0-e36c4cdd3b72",
          "import_batch_id": "3ee87fcd-f0ef-4152-94b0-d584085b4ee6",
