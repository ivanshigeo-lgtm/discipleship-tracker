        {
          "created_at": "2026-07-05T01:01:13.923648+00:00",
          "date_precision": "day",
          "id": "4c629621-bdf1-4405-bfc0-8d5ad807ab34",
          "import_batch_id": "3ee87fcd-f0ef-4152-94b0-d584085b4ee6",
