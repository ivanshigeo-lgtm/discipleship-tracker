        {
          "created_at": "2026-07-05T02:37:20.65726+00:00",
          "date_precision": "day",
          "date_reviewed": false,
          "id": "5d5ae0c9-a5a4-496a-abd8-54c9c9b3e011",
          "import_batch_id": "0a60c730-b41f-4aa3-af6f-52f2927c7034",
          "import_seq": 34001,
          "journal_date": "2024-05-16",
          "ocr_text": "S- Behold the days are coming that I will punish all who are uncircumcised with the uncircumcised. For all these nations are uncircumcised and all the house of Israel are are uncircumcised in the heart.\nO- Punishment was decided by God not according to what nation or religion or family or custom but according to what is in the heart. Man judges by the actions that can be seen but God is the only one who sees the heart.\nA- I should care more about what my motives and intentions are rather than what is seen by others. Ultimately it doesn't and won't matter what people think but what God thinks.\nP- God help us to value your opinion more than the opinion of others.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218417485.jpg",
