        {
          "created_at": "2026-07-05T02:35:54.787566+00:00",
          "date_precision": "day",
          "date_reviewed": false,
          "id": "1f82571e-2010-4260-9f05-b8afb01c0a33",
          "import_batch_id": "0a60c730-b41f-4aa3-af6f-52f2927c7034",
          "import_seq": 26000,
          "journal_date": "2024-04-15",
          "ocr_text": "S- They have forsaken me, the fountain of living waters. And fixed themselves cisterns, broken cistern that can hold no water. Jer 2:13\nO- Israel exchanged fountains for broken cisterns. A-I do this when I pursue money and pleasure more than God's pleasure.\nP- Help me to do such a habit to pursue wealth. I don't want to idolize it. Help me to prioritize you and others more than money.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218415414.jpg",
