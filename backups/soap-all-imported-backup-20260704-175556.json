        {
          "created_at": "2026-07-05T01:48:21.375399+00:00",
          "date_precision": "day",
          "date_reviewed": false,
          "id": "35115ee4-9ae8-4d29-bfa9-2877ca80d6a2",
          "import_batch_id": "b6b1042e-bed6-40e2-80f4-debdd9e59219",
          "import_seq": 72000,
          "journal_date": "2025-10-08",
          "ocr_text": "S - Behold I am coming as a thief. Blessed is he who watches and keeps his garments lest he walk naked and see his shame. Rev 16:15\n\nO - All these bowls of wrath were poured out and the hardness of man was so great that judgment didn't change their minds or hearts.\n\nA - I hope that every discipline that God gives to me makes my heart softer and more teachable and humble to God. Punishment/Discipline can make people repent or rebel depending on the condition of the heart.\n\nP - God, please continue to give me grace, help me to love you more. I plead or in lack, let me love you more.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783213261208.jpeg",
          "photo_urls": [
            "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783213261208.jpeg"
