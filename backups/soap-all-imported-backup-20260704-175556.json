          "date_reviewed": false,
          "id": "05e1a35d-600b-4c49-8dfd-f73f7f3c8c4e",
          "import_batch_id": "0a60c730-b41f-4aa3-af6f-52f2927c7034",
          "import_seq": 25003,
          "journal_date": "2024-04-14",
          "ocr_text": "S- What injustice have your Fathers found in me, that they have gone far from me? Have followed idols and have become idolaters? Jer 2:5\n\nO- God asks me, what have I done that you hate followed after other things? God gave us land, and live used that land to leverage into cash-flow opportunities.\n\nA- God gave me everything. I should continue to seek him first and be generous to others.\n\nP- God help me to sort out my finances and get it done.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218415224.jpg",
          "photo_urls": [
            "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218415224.jpg"
          ],
          "scripture_reference": "Jer 2:5",
          "source": "imported",
          "summary": null,
          "updated_at": "2026-07-05T02:35:43.941+00:00",
