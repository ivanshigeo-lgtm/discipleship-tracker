          "import_batch_id": "0a60c730-b41f-4aa3-af6f-52f2927c7034",
          "import_seq": 37002,
          "journal_date": "2024-05-29",
          "ocr_text": "S- The king has brought me into his chamber. 2:4. His banner over me is love and he has placed away from her beloved.\n\nA- Although I am separated from my beloved I can and will wait for His love.\n\nP- God help me to be patient. Although I'm not with you know I'm forever help me to keep Gifted to you.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218418327.jpg",
