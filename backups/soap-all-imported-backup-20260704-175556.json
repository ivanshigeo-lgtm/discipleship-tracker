          "source": "imported",
          "summary": null,
          "updated_at": "2026-07-05T01:49:04.973+00:00",
          "visibility": "private"
        },
        {
          "created_at": "2026-07-05T01:50:53.33322+00:00",
          "date_precision": "day",
          "date_reviewed": false,
          "id": "b934bc32-6cd2-4c84-a028-feae06b5a75d",
          "import_batch_id": "b6b1042e-bed6-40e2-80f4-debdd9e59219",
          "import_seq": 87000,
          "journal_date": "2025-12-22",
          "ocr_text": "S- Correct your son and he will give you rest. Yes he will give delight to your soul. Prov 29:17\n\nO- Rest is given through the mentoring of the younger generation. Delight is seeing them succeed.\n\nA- I need to constantly provide opportunity for practice and growth in the younger generation and for myself.\n\nP- God give me the wisdom to walk yourself and the leader that you have given me.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783213532343.jpeg",
