        {
          "created_at": "2026-07-05T02:37:53.613937+00:00",
          "date_precision": "day",
          "date_reviewed": false,
          "id": "57e54c00-7f22-490b-9ad7-ea3e29884767",
          "import_batch_id": "0a60c730-b41f-4aa3-af6f-52f2927c7034",
          "import_seq": 42002,
          "journal_date": "2024-06-16",
          "ocr_text": "S - The root of your mouth like the best wine. The wine goes down smoothly for my beloved. SOS 8:7.\n\nO - Solomon wants the Shulamite. She only wants the beloved. A jealousy is as cruel as the grave. Solomon wanted her. But couldn't have her. He wanted to win her heart. He wanted to make her an indebted slave. She had enough to give Solomon, and be gone and work for her time to her beloved instead of her brothers. She could give her love freely to her beloved because she could pay the 1000 silver tag. (33 employees.) All because she gave her heart to the Shepherd.\n\nP - God help me to give my heart completely to you.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218419634.jpg",
          "photo_urls": [
            "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218419634.jpg"
          ],
          "scripture_reference": "Song of Solomon 8:6-7",
          "source": "imported",
          "summary": null,
          "updated_at": "2026-07-05T02:37:53.562+00:00",
          "visibility": "private"
        },
        {
