          "date_precision": "day",
          "date_reviewed": false,
          "id": "12755a41-7245-4ab8-ac41-ce4b8f0b48b4",
          "import_batch_id": "0a60c730-b41f-4aa3-af6f-52f2927c7034",
          "import_seq": 44001,
          "journal_date": "2024-06-24",
          "ocr_text": "S- For I consider that the sufferings of this present time are not worthy to be compared with the Glory that shall be revealed in us.\nO- Paul had the perspective of focusing on what would come from the suffering instead of the suffering. By having a baby.\nA- Focus on the future. What good will come from this?\nP- God help me to focus on the good and to rejoice in my suffering.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218420135.jpg",
          "photo_urls": [
            "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218420135.jpg"
          ],
