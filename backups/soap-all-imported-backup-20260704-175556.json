        {
          "created_at": "2026-07-05T02:37:01.629683+00:00",
          "date_precision": "day",
          "date_reviewed": false,
          "id": "b5d6a041-9560-4248-84cf-1a9828fe9730",
          "import_batch_id": "0a60c730-b41f-4aa3-af6f-52f2927c7034",
          "import_seq": 32000,
          "journal_date": "2024-08-06",
          "ocr_text": "Say to wisdom \"You are my sister\" and call understanding your nearest kin, that they may keep you from the immoral woman, from the seductress who flatters with her words. Prov 9:4,5\n\nO - A close relationship with wisdom is being guarded from a wrong relationship with the seductress\n\nA - I must get closer to wisdom to be a defense to all the temptations everywhere\n\nP - Thank you, Jesus that you are wisdom. That is keeping me. I can overcome every temptation",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218417094.jpg",
          "photo_urls": [
