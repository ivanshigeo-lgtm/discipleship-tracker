          "import_seq": 32001,
          "journal_date": "2024-05-09",
          "ocr_text": "S - I love those who love me and those who seek me diligently shall find me. Pov 8:17\n\nO - Those who love wisdom will seek wisdom diligently.\n\nA - If I love wisdom, I will pursue it with all my heart and God it\n\nP - God help me to love you with all my heart.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218417094.jpg",
          "photo_urls": [
            "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783218417094.jpg"
