          "date_precision": "day",
          "date_reviewed": false,
          "id": "b6bb666e-af80-4d2c-acba-5d0131399a24",
          "import_batch_id": "b6b1042e-bed6-40e2-80f4-debdd9e59219",
          "import_seq": 68002,
          "journal_date": "2025-09-16",
          "ocr_text": "S- Behold I am coming quickly! Blessed is he who keeps the words of the prophecy of this book. Rev 22:7\n\nO- Jesus' return is soon. I should do everything I can do to prepare for His return.\n\nA- In light of His return I should prepare for it by serving Christ and having integrity of heart and putting Christ first.\n\nP- I want to love you more and give my life to you more. Please increase my love for you. Godly pls.",
          "person_id": "2aa35958-9057-44bd-aaf2-bd12a4cf9ecd",
          "photo_url": "https://yddjlhdptsundeimugba.supabase.co/storage/v1/object/public/soap-photos/2aa35958-9057-44bd-aaf2-bd12a4cf9ecd/1783213160566.jpeg",
